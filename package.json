{
  "name": "vitryla-ui",
  "version": "1.0.0",
  "private": false,
  "description": "Vitryla UI: React UI kit with composable primitives, theming and accessibility defaults",
  "author": "NikitaBerezhnyj",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "accessibility",
    "a11y",
    "theming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikitaBerezhnyj/vitryla-ui.git"
  },
  "bugs": {
    "url": "https://github.com/NikitaBerezhnyj/vitryla-ui/issues"
  },
  "homepage": "https://github.com/NikitaBerezhnyj/vitryla-ui#readme",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build --mode lib",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "prepublishOnly": "npm run build && npm run check:package",
    "prepack": "node scripts/package-readme.mjs apply",
    "postpack": "node scripts/package-readme.mjs restore",
    "readme:restore": "node scripts/package-readme.mjs restore"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-storybook": "^10.6.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "latest",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  }
}
